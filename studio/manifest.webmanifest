{
  "id": "/studio/",
  "name": "Sunshine Studio",
  "short_name": "Studio",
  "description": "Add new pieces to Sunshine's Boutique from your phone.",
  "start_url": "/studio/",
  "scope": "/studio/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#2A1E17",
  "theme_color": "#2A1E17",
  "icons": [
    { "src": "/assets/studio-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/assets/studio-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/assets/studio-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/studio/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{ "name": "photos", "accept": ["image/*", "image/jpeg", "image/png", "image/webp", "image/heic"] }]
    }
  }
}
